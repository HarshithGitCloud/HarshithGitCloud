									"parameters": {
										"pDirectory": {
											"value": "@concat('landing/supply_chain/', item())",
											"type": "Expression"
										},
										"pFileName": "@concat(item(), '.csv')"
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_SupplyChain_Landing_Param",
									"type": "DatasetReference",
									"parameters": {
										"pDirectory": "@concat('landing/adf_ingested/', item())",
										"pFileName": "@concat(item(), '.csv')"
									}
								}
							]
						}
					]
				}
			}
		],
